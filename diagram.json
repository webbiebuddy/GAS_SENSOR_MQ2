{
  "version": 1,
  "author": "Silent Leak simulation",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 10, "left": 5, "attrs": {} },
    { "type": "wokwi-gas-sensor", "id": "mq2", "top": -55, "left": -80, "attrs": { "ppm": "400", "threshold": "4.8" } },
    { "type": "wokwi-relay-module", "id": "relay", "top": 20, "left": 210, "attrs": { "transistor": "pnp" } },
    { "type": "wokwi-buzzer", "id": "buzzer", "top": 190, "left": 275, "attrs": { "volume": "0.3" } },
    { "type": "wokwi-led", "id": "status-led", "top": 175, "left": -90, "attrs": { "color": "yellow" } },
    { "type": "wokwi-resistor", "id": "r-status", "top": 215, "left": -72, "attrs": { "value": "330" } },
    { "type": "wokwi-led", "id": "alarm-led", "top": 155, "left": 355, "attrs": { "color": "red" } },
    { "type": "wokwi-resistor", "id": "r-alarm", "top": 205, "left": 375, "attrs": { "value": "330" } },
    { "type": "wokwi-led", "id": "ok-led", "top": 55, "left": 355, "attrs": { "color": "green" } },
    { "type": "wokwi-resistor", "id": "r-ok", "top": 105, "left": 375, "attrs": { "value": "330" } },
    { "type": "wokwi-servo", "id": "valve", "top": 300, "left": -110, "attrs": { "label": "GAS VALVE" } },
    { "type": "wokwi-pushbutton", "id": "btn-inject", "top": 360, "left": 470, "attrs": { "label": "INJECT GAS", "key": "g", "color": "green" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "mq2:VCC", "esp:5V", "red", [ "v0" ] ],
    [ "mq2:GND", "esp:GND.1", "black", [ "v0" ] ],
    [ "mq2:AOUT", "esp:34", "orange", [ "v0" ] ],
    [ "mq2:DOUT", "relay:IN", "purple", [ "v0" ] ],
    [ "relay:VCC", "esp:5V", "red", [ "v0" ] ],
    [ "relay:GND", "esp:GND.1", "black", [ "v0" ] ],
    [ "relay:COM", "esp:5V", "red", [ "v0" ] ],
    [ "esp:12", "r-status:1", "yellow", [ "v0" ] ],
    [ "r-status:2", "status-led:A", "yellow", [ "v0" ] ],
    [ "status-led:C", "esp:GND.1", "black", [ "v0" ] ],
    [ "esp:14", "buzzer:2", "orange", [ "v0" ] ],
    [ "buzzer:1", "esp:GND.1", "black", [ "v0" ] ],
    [ "relay:NO", "alarm-led:A", "red", [ "v0" ] ],
    [ "alarm-led:C", "r-alarm:1", "red", [ "v0" ] ],
    [ "r-alarm:2", "esp:GND.1", "black", [ "v0" ] ],
    [ "relay:NC", "ok-led:A", "green", [ "v0" ] ],
    [ "ok-led:C", "r-ok:1", "green", [ "v0" ] ],
    [ "r-ok:2", "esp:GND.1", "black", [ "v0" ] ],
    [ "esp:18", "valve:PWM", "orange", [ "v0" ] ],
    [ "valve:V+", "esp:5V", "red", [ "v0" ] ],
    [ "valve:GND", "esp:GND.1", "black", [ "v0" ] ],
    [ "esp:32", "btn-inject:1.l", "green", [ "v0" ] ],
    [ "btn-inject:2.l", "esp:GND.1", "black", [ "v0" ] ]
  ]
}
